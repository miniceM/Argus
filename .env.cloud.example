# 复制为 .env.cloud 后填入你的 Langfuse Cloud 凭据。
# .env.cloud 已在 .gitignore 中，切勿提交。
#
# 区域选择（三选一，按你账号注册的区域）：
#   EU: https://cloud.langfuse.com
#   US: https://us.cloud.langfuse.com
#   JP: https://jp.cloud.langfuse.com
#
# 凭据获取：Langfuse Cloud → 项目 → Settings → API Keys

LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 设置为当前账号区域中浏览器可访问的 Langfuse UI 地址。
# 它可以不同于 Runner 用于连接 API 的 LANGFUSE_BASE_URL。
ARGUS_LANGFUSE_DASHBOARD_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
