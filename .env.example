# 从本文件复制为 .env.poc 后再修改。以下值均为示例值。
NEXTAUTH_URL=http://localhost:3000
# 如果浏览器访问的 Langfuse UI 地址与 NEXTAUTH_URL 不同，可设置此变量。
# ARGUS_LANGFUSE_DASHBOARD_URL=https://observability.example.com/langfuse
NEXTAUTH_SECRET=change-me
SALT=change-me
ENCRYPTION_KEY=change-me-with-64-hex-chars
TELEMETRY_ENABLED=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
REDIS_AUTH=change-me
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
LANGFUSE_INIT_ORG_ID=poc-org
LANGFUSE_INIT_ORG_NAME=Enterprise Agent Eval PoC
LANGFUSE_INIT_PROJECT_ID=poc-project
LANGFUSE_INIT_PROJECT_NAME=Agent Evaluation
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_replace_me
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_replace_me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=PoC Admin
LANGFUSE_INIT_USER_PASSWORD=change-me
LANGFUSE_UI_DEFAULT_LOCALE=zh-CN

# 默认生产凭据：Argus Managed Secret，外部受限文件 + deploy/credentials.compose.yml。
# 文件内容不能放入此 env 文件或数据库备份；详见 docs/secret-providers.md。
# ARGUS_MANAGED_SECRET_KEY_SOURCE=/secure/argus/keyring.json
# ARGUS_CREDENTIAL_ADMIN_TOKEN_SOURCE=/secure/argus/admin-token
# env:// 仅用于本地开发/PoC；下列变量由根 Compose 显式传入 Runner：
# ARGUS_SECRET_MODE=development
# ARGUS_ALLOWED_CREDENTIAL_ENVS=DEMO_AUTH_TOKEN
# DEMO_AUTH_TOKEN=local-demo-token

# 门禁报告链接使用浏览器可访问的 Console 地址。
ARGUS_CONSOLE_BASE_URL=http://localhost:18083
