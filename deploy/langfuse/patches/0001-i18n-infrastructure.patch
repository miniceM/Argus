@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import { FALLBACK_LOCALE, readLocaleCookie, resolveLocale } from "./config";
+
+describe("locale resolution", () => {
+  it("prefers a valid explicit cookie", () => {
+    expect(resolveLocale({ cookieLocale: "en", defaultLocale: "zh-CN" })).toBe(
+      "en",
+    );
+  });
+
+  it("uses the deployment default when the cookie is absent or invalid", () => {
+    expect(resolveLocale({ defaultLocale: "zh-CN" })).toBe("zh-CN");
+    expect(resolveLocale({ cookieLocale: "de", defaultLocale: "zh-CN" })).toBe(
+      "zh-CN",
+    );
+  });
+
+  it("falls back safely to English", () => {
+    expect(resolveLocale({ defaultLocale: "invalid" })).toBe(FALLBACK_LOCALE);
+  });
+
+  it("reads only the locale cookie", () => {
+    expect(readLocaleCookie("session=secret; langfuse-locale=zh-CN")).toBe(
+      "zh-CN",
+    );
+    expect(readLocaleCookie("other=en")).toBeUndefined();
+  });
+
+  it("does not share locale state between requests", () => {
+    const zhRequest = resolveLocale({ cookieLocale: "zh-CN" });
+    const enRequest = resolveLocale({ cookieLocale: "en" });
+    expect([zhRequest, enRequest]).toEqual(["zh-CN", "en"]);
+  });
+});
