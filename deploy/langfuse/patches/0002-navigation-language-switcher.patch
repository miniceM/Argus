@@ -0,0 +1,94 @@
+export const KNOWN_UI_LABEL_KEYS = {
+  "Go to...": "goTo",
+  Organizations: "organizations",
+  Organization: "organization",
+  Projects: "projects",
+  Home: "home",
+  Dashboards: "dashboards",
+  Tracing: "tracing",
+  Traces: "traces",
+  Observations: "observations",
+  Sessions: "sessions",
+  Users: "users",
+  Alerts: "alerts",
+  Prompts: "prompts",
+  Playground: "playground",
+  Scores: "scores",
+  Evaluators: "evaluators",
+  "Human Annotation": "humanAnnotation",
+  Datasets: "datasets",
+  Experiments: "experiments",
+  Settings: "settings",
+  Update: "update",
+  "Cloud Status": "cloudStatus",
+  "V4 Preview": "v4Preview",
+  "Upgrade Plan": "upgradePlan",
+  "Book a call": "bookCall",
+  Support: "support",
+} as const;
+
+export const ROUTE_GROUP_KEYS = {
+  Observability: "observability",
+  "Prompt Management": "promptManagement",
+  Evaluation: "evaluation",
+} as const;
+
+export const TABLE_LABEL_KEYS = {
+  Name: "name",
+  "Created at": "createdAt",
+  "Updated at": "updatedAt",
+  Status: "status",
+  Input: "input",
+  Output: "output",
+  Metadata: "metadata",
+  Latency: "latency",
+  Cost: "cost",
+  Usage: "usage",
+  Actions: "actions",
+} as const;
+
+export const COMMON_LABEL_KEYS = {
+  Save: "save",
+  Cancel: "cancel",
+  Create: "create",
+  Delete: "delete",
+  Edit: "edit",
+  Close: "close",
+  Search: "search",
+  Loading: "loading",
+} as const;
+
+export const STATE_LABEL_KEYS = {
+  "No data": "empty",
+  "No data available": "empty",
+  "No results.": "noResults",
+  "No results found": "noResults",
+  "Something went wrong": "error",
+  "Try again": "retry",
+} as const;
+
+export type KnownUiLabel = keyof typeof KNOWN_UI_LABEL_KEYS;
+export type KnownRouteGroup = keyof typeof ROUTE_GROUP_KEYS;
+export type KnownTableLabel = keyof typeof TABLE_LABEL_KEYS;
+export type KnownCommonLabel = keyof typeof COMMON_LABEL_KEYS;
+export type KnownStateLabel = keyof typeof STATE_LABEL_KEYS;
+
+export function isKnownUiLabel(value: string): value is KnownUiLabel {
+  return value in KNOWN_UI_LABEL_KEYS;
+}
+
+export function isKnownRouteGroup(value: string): value is KnownRouteGroup {
+  return value in ROUTE_GROUP_KEYS;
+}
+
+export function isKnownTableLabel(value: string): value is KnownTableLabel {
+  return value in TABLE_LABEL_KEYS;
+}
+
+export function isKnownCommonLabel(value: string): value is KnownCommonLabel {
+  return value in COMMON_LABEL_KEYS;
+}
+
+export function isKnownStateLabel(value: string): value is KnownStateLabel {
+  return value in STATE_LABEL_KEYS;
+}
