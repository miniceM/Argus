diff --git a/web/src/features/i18n/LanguageSwitcher.clienttest.tsx b/web/src/features/i18n/LanguageSwitcher.clienttest.tsx
new file mode 100644
index 0000000..3d3a004
--- /dev/null
+++ b/web/src/features/i18n/LanguageSwitcher.clienttest.tsx
@@ -0,0 +1,33 @@
+import { fireEvent, render, screen } from "@testing-library/react";
+import { NextIntlClientProvider } from "next-intl";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import en from "../../../messages/en.json";
+import { LanguageSwitcher } from "./LanguageSwitcher";
+
+const reload = vi.fn();
+
+vi.mock("next/router", () => ({
+  useRouter: () => ({ reload }),
+}));
+
+describe("LanguageSwitcher", () => {
+  beforeEach(() => {
+    reload.mockClear();
+    document.cookie = "langfuse-locale=; Path=/; Max-Age=0";
+  });
+
+  it("stores the explicit preference and reloads the current route", () => {
+    render(
+      <NextIntlClientProvider locale="en" messages={en} timeZone="UTC">
+        <LanguageSwitcher />
+      </NextIntlClientProvider>,
+    );
+
+    fireEvent.change(screen.getByRole("combobox", { name: "Language" }), {
+      target: { value: "zh-CN" },
+    });
+
+    expect(document.cookie).toContain("langfuse-locale=zh-CN");
+    expect(reload).toHaveBeenCalledOnce();
+  });
+});
diff --git a/web/src/features/i18n/LanguageSwitcher.tsx b/web/src/features/i18n/LanguageSwitcher.tsx
new file mode 100644
index 0000000..2759e4a
--- /dev/null
+++ b/web/src/features/i18n/LanguageSwitcher.tsx
@@ -0,0 +1,47 @@
+"use client";
+
+import { Languages } from "lucide-react";
+import { useLocale, useTranslations } from "next-intl";
+import { useRouter } from "next/router";
+import { useState } from "react";
+import {
+  isSupportedLocale,
+  LOCALE_COOKIE_NAME,
+  type AppLocale,
+} from "./config";
+
+const COOKIE_MAX_AGE_SECONDS = 365 * 24 * 60 * 60;
+
+export function LanguageSwitcher() {
+  const router = useRouter();
+  const currentLocale = useLocale();
+  const t = useTranslations("common");
+  const [isSwitching, setIsSwitching] = useState(false);
+
+  const switchLocale = (locale: AppLocale) => {
+    if (locale === currentLocale) return;
+    setIsSwitching(true);
+    document.cookie = `${LOCALE_COOKIE_NAME}=${encodeURIComponent(locale)}; Path=/; Max-Age=${COOKIE_MAX_AGE_SECONDS}; SameSite=Lax`;
+    router.reload();
+  };
+
+  return (
+    <label className="flex min-w-0 items-center gap-2 px-2 py-1 text-sm">
+      <Languages aria-hidden className="h-4 w-4 shrink-0" />
+      <span className="sr-only">{t("switchLanguage")}</span>
+      <select
+        aria-label={t("language")}
+        className="bg-background min-w-0 flex-1 rounded-md border px-2 py-1"
+        disabled={isSwitching}
+        value={isSupportedLocale(currentLocale) ? currentLocale : "en"}
+        onChange={(event) => {
+          const locale = event.target.value;
+          if (isSupportedLocale(locale)) switchLocale(locale);
+        }}
+      >
+        <option value="zh-CN">{t("simplifiedChinese")}</option>
+        <option value="en">{t("english")}</option>
+      </select>
+    </label>
+  );
+}
