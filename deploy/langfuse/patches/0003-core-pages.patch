diff --git a/web/src/features/i18n/LocalizedUiLabel.tsx b/web/src/features/i18n/LocalizedUiLabel.tsx
new file mode 100644
index 0000000..061ea4b
--- /dev/null
+++ b/web/src/features/i18n/LocalizedUiLabel.tsx
@@ -0,0 +1,40 @@
+import { Children, type ReactNode } from "react";
+import { useTranslations } from "next-intl";
+import {
+  COMMON_LABEL_KEYS,
+  isKnownCommonLabel,
+  isKnownStateLabel,
+  isKnownTableLabel,
+  isKnownUiLabel,
+  KNOWN_UI_LABEL_KEYS,
+  TABLE_LABEL_KEYS,
+  STATE_LABEL_KEYS,
+} from "./knownUiLabels";
+
+export function LocalizedUiLabel({ children }: { children: ReactNode }) {
+  const navigation = useTranslations("navigation");
+  const tables = useTranslations("tables");
+  const common = useTranslations("common");
+  const states = useTranslations("states");
+
+  const localize = (value: ReactNode): ReactNode => {
+    if (typeof value !== "string") return value;
+    if (isKnownUiLabel(value)) {
+      return navigation(KNOWN_UI_LABEL_KEYS[value]);
+    }
+    if (isKnownTableLabel(value)) {
+      return tables(TABLE_LABEL_KEYS[value]);
+    }
+    if (isKnownCommonLabel(value)) {
+      return common(COMMON_LABEL_KEYS[value]);
+    }
+    if (isKnownStateLabel(value)) {
+      return states(STATE_LABEL_KEYS[value]);
+    }
+    return value;
+  };
+
+  return typeof children === "string"
+    ? localize(children)
+    : Children.map(children, localize);
+}
