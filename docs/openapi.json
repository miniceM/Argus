              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Agent Registry"
        ],
        "summary": "Query an Agent by ID (?id=...) or list all agents",
        "operationId": "get_or_list_agents_api_v1_agents_get",
