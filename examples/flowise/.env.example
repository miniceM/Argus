# 复制到根目录 .env.flowise；禁止提交真实值。
ARGUS_BUILD_ID=replace-with-git-rev-parse-HEAD
LANGFUSE_BASE_URL=https://your-test-project.example.invalid
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
MODEL_BASE_URL=https://your-model-gateway.example.invalid/v1
MODEL_API_KEY=replace-me
MODEL_NAME=replace-with-pinned-model-id
# 可选：OpenCode Go 等网关要求额外路由头。只使用测试值，不填个人信息。
MODEL_EXTRA_HEADERS={}
# 仅本地专用 Flowise 的初始 owner，不用于已有共享服务。
FLOWISE_EMAIL=p0@example.invalid
FLOWISE_PASSWORD=replace-with-strong-local-password
FLOWISE_PORT=19091
ARGUS_PORT=19090
CONSOLE_PORT=19093
TOOL_PORT=19094
